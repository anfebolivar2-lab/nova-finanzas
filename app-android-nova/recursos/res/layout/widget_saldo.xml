<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NOVA ✦"
        android:textColor="#CDEEE0"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_saldo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="Abre NOVA"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_linea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="para ver tu saldo aquí"
        android:textColor="#E6F6EE"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_gasto"
            style="@style/NovaWidgetBoton"
            android:text="＋ Gasto" />
        <TextView
            android:id="@+id/widget_frecuente_1"
            style="@style/NovaWidgetBoton"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_frecuente_2"
            style="@style/NovaWidgetBoton"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_frecuente_3"
            style="@style/NovaWidgetBoton"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
